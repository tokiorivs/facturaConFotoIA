[options]
; Clave para crear/borrar bases desde la web (en producción además list_db = False)
admin_passwd = CAMBIAR_POR_UNA_CLAVE_FUERTE

db_host = 127.0.0.1
db_port = 5432
db_user = odoo
db_password = CAMBIAR
db_name = midb
dbfilter = ^midb$
list_db = False

addons_path = /opt/odoo/odoo/addons,/opt/odoo/custom_addons
data_dir = /var/lib/odoo
logfile = /var/log/odoo/odoo.log

; Detrás de nginx
http_interface = 127.0.0.1
http_port = 8069
gevent_port = 8072
proxy_mode = True

; Procesos. La llamada a Gemini puede tardar hasta ~5 min en el peor caso (3 intentos),
; por eso limit_time_real es alto.
workers = 2
max_cron_threads = 1
limit_time_cpu = 120
limit_time_real = 360
limit_memory_soft = 1073741824
limit_memory_hard = 1342177280
