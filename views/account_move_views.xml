<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_foto_facturacion" model="ir.ui.view">
        <field name="name">account.move.form.foto.facturacion</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_rellenar_con_ia" type="object" string="Rellenar con IA"
                        class="btn-secondary" groups="account.group_account_invoice"
                        invisible="move_type != 'in_invoice' or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
